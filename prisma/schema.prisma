generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
}

enum JobStatus {
  OPEN
  CLOSED
}

enum CandidateStatus {
  NEW
  SHORTLISTED
  REJECTED
}

enum InterviewStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
  DUPLICATE
}

enum InterviewStep {
  GREETING
  CV
  VIDEO
  SCREENING
  DONE
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum AIProvider {
  CLAUDE
  OPENAI
}

enum AIPurpose {
  INTERVIEW_TURN
  SCREENING_GEN
  SUMMARY
  TTS
  TRANSLATION
}

enum VideoChoice {
  PENDING
  YES
  NO
}

enum AnswerQuality {
  GOOD
  OKAY
  POOR
}

enum AnswerFit {
  POSITIVE
  NEUTRAL
  NEGATIVE
  NA
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
}

model Job {
  id                 String      @id @default(cuid())
  slug               String      @unique
  title              String
  description        String
  location           String
  salaryMin          Int?
  salaryMax          Int?
  jobType            JobType
  openings           Int         @default(1)
  requiredSkills     String[]
  experienceRequired String?
  customQuestions    String[] // admin's screening questions
  generatedQuestions String[] // AI-generated 2–4 questions
  aiProvider         AIProvider? // null → env default
  aiModel            String?
  status             JobStatus   @default(OPEN)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  candidates         Candidate[]
  interviews         Interview[]
  aiUsages           AIUsage[]

  @@index([status])
}

// One application = one candidate row per job
model Candidate {
  id                   String            @id @default(cuid())
  jobId                String
  job                  Job               @relation(fields: [jobId], references: [id])
  fullName             String?
  phone                String?
  age                  Int?
  gender               String?
  city                 String?
  willingToRelocate    Boolean?
  education            String?
  totalExperienceYears Float?
  previousJobs         Json? // [{ company, role, duration }]
  skills               String[]
  languagesKnown       String[]
  certifications       String[]
  currentSalary        String?
  expectedSalary       String?
  joiningDate          String?
  status               CandidateStatus   @default(NEW)
  aiSummary            String?
  fitScore             Int?
  fitReason            String?
  flaggedCount         Int               @default(0)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  interview            Interview?
  screeningAnswers     ScreeningAnswer[]
  video                Video?

  @@unique([jobId, phone]) // duplicate protection
  @@index([status])
  @@index([createdAt])
}

model Interview {
  id           String          @id @default(cuid())
  jobId        String
  job          Job             @relation(fields: [jobId], references: [id])
  candidateId  String          @unique
  candidate    Candidate       @relation(fields: [candidateId], references: [id])
  language     String // "en", "hi", …
  provider     AIProvider
  model        String
  status       InterviewStatus @default(IN_PROGRESS)
  step         InterviewStep   @default(GREETING)
  videoChoice  VideoChoice     @default(PENDING)
  screeningIdx Int             @default(0)
  progress     Json            @default("{}") // { done: [target], attempts: {target: n}, flagged: [target] }
  resumeToken  String          @unique
  startedAt    DateTime        @default(now())
  endedAt      DateTime?
  messages     Message[]
  aiUsages     AIUsage[]
  answerChecks AnswerCheck[]

  @@index([jobId, startedAt])
  @@index([language])
}

model Message {
  id           String      @id @default(cuid())
  interviewId  String
  interview    Interview   @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  role         MessageRole
  content      String
  inputTokens  Int?
  outputTokens Int?
  createdAt    DateTime    @default(now())

  @@index([interviewId, createdAt])
}

// One row per answer attempt
model AnswerCheck {
  id            String        @id @default(cuid())
  interviewId   String
  interview     Interview     @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  messageId     String? // the candidate's message being judged
  target        String // CV field key ("phone") or "screening:<order>"
  question      String
  answer        String
  inputMode     String // "voice" | "text"
  sttConfidence Float?
  relevant      Boolean
  clear         Boolean
  valid         Boolean
  misheard      Boolean
  quality       AnswerQuality
  fit           AnswerFit     @default(NA)
  fitReason     String?
  attempt       Int           @default(1) // 1..3
  flagged       Boolean       @default(false) // still POOR after 2 retries
  createdAt     DateTime      @default(now())

  @@index([interviewId, target])
}

model ScreeningAnswer {
  id          String         @id @default(cuid())
  candidateId String
  candidate   Candidate      @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  question    String
  answer      String
  source      String // "custom" | "ai"
  order       Int
  quality     AnswerQuality?
  fit         AnswerFit?
  fitReason   String?
  flagged     Boolean        @default(false)
  createdAt   DateTime       @default(now())
}

model Video {
  id          String    @id @default(cuid())
  candidateId String    @unique
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  storageKey  String // driver-agnostic key
  url         String
  mimeType    String
  durationSec Int?
  sizeBytes   Int?
  createdAt   DateTime  @default(now())
}

model AIUsage {
  id               String     @id @default(cuid())
  interviewId      String?
  interview        Interview? @relation(fields: [interviewId], references: [id])
  jobId            String?
  job              Job?       @relation(fields: [jobId], references: [id])
  purpose          AIPurpose
  provider         AIProvider
  model            String
  inputTokens      Int
  outputTokens     Int
  cacheReadTokens  Int        @default(0) // part of inputTokens served from prompt cache (cheaper)
  cacheWriteTokens Int        @default(0) // part of inputTokens written to prompt cache (Claude: 1.25x)
  costUsd          Decimal    @db.Decimal(12, 6)
  costInr          Decimal    @db.Decimal(12, 4)
  usdToInr         Decimal    @db.Decimal(10, 4) // rate snapshot
  createdAt        DateTime   @default(now())

  @@index([createdAt])
  @@index([provider])
  @@index([jobId])
}

model ModelPricing {
  id                  String     @id @default(cuid())
  provider            AIProvider
  model               String
  inputPerMillionUsd  Decimal    @db.Decimal(10, 4)
  outputPerMillionUsd Decimal    @db.Decimal(10, 4)
  active              Boolean    @default(true)
  updatedAt           DateTime   @updatedAt

  @@unique([provider, model])
}
