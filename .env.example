# --- Database (PostgreSQL in Docker) ---
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/hiring_poc?schema=public"

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="Admin@123"

# --- App ---
APP_BASE_URL="http://localhost:3000"
USD_TO_INR="84"

# --- AI ---
AI_PROVIDER="claude"          # claude | openai
CLAUDE_MODEL=""               # empty = claude-haiku-5-5
OPENAI_MODEL=""               # empty = gpt-6.1-sol
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# --- Text-to-speech ---
TTS_MODE="server"             # server (Google voice, recommended) | auto (phone voice first) | browser
# Google Cloud Text-to-Speech: a service-account JSON file (used if set) OR an API key
GOOGLE_APPLICATION_CREDENTIALS=""   # e.g. "./google-tts.json" (path from the project folder; never commit it)
GOOGLE_TTS_API_KEY=""

# --- Storage / limits ---
STORAGE_DRIVER="local"        # local | s3
RATE_LIMIT_PER_MIN="20"
